modules = ["nodejs-20", "web", "bash", "postgresql-16", "python-3.11"]
[agent]
expertMode = true
integrations = ["github:1.0.0", "javascript_database:1.0.0", "javascript_openai_ai_integrations:1.0.0"]

[nix]
channel = "stable-25_05"
packages = ["unzip"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Dev Server"

[[workflows.workflow]]
name = "Dev Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 24678
externalPort = 3000

[[ports]]
localPort = 34721
externalPort = 3003

[[ports]]
localPort = 37359
externalPort = 3001

[[ports]]
localPort = 37879
externalPort = 4200

[[ports]]
localPort = 37907
externalPort = 3002

[[ports]]
localPort = 41631
externalPort = 5173

[[ports]]
localPort = 46285
externalPort = 5000

[deployment]
deploymentTarget = "autoscale"
run = ["npm", "run", "preview"]
build = ["npm", "run", "build"]
