# Room XI Connect - Environment Variables Template
# Copy this file to .env and fill in your actual values
# Architecture: Express.js + Neon PostgreSQL + Drizzle ORM

# ============================================================================
# DATABASE CONFIGURATION (Required)
# ============================================================================
# Neon PostgreSQL connection string
# Get from: https://console.neon.tech/app/projects
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# ============================================================================
# EMAIL CONFIGURATION (Required for Guardian Consent Emails)
# ============================================================================
# Choose email provider: "gmail" or "sendgrid"
EMAIL_PROVIDER=gmail

# Option 1: Gmail SMTP (Free)
# Get app password from: https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
EMAIL_FROM=consent@roomxiconnect.org
EMAIL_FROM_NAME=Room XI Connect

# Option 2: SendGrid (Paid, ~$15/month)
# Get API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# ============================================================================
# APPLICATION CONFIGURATION (Required for Production)
# ============================================================================

# Production URL (used in emails and redirects)
APP_URL=https://roomxiconnect.org

# Local development URL (for frontend)
VITE_APP_URL=http://localhost:5173

# Session secret (REQUIRED in production, random 32+ characters)
# Generate with: openssl rand -base64 32
SESSION_SECRET=your_session_secret_here_CHANGE_IN_PRODUCTION

# Encryption secret (REQUIRED for health data & journal encryption, random 32+ characters)
# Generate with: openssl rand -base64 32
ENCRYPTION_SECRET=your_encryption_secret_here_CHANGE_IN_PRODUCTION

# Safety plan token pepper (REQUIRED for safety plan share link security, random 32+ characters)
# Used to hash tokens for safety plan public share links
# Generate with: openssl rand -base64 32 or node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SAFETY_PLAN_TOKEN_PEPPER=your_safety_plan_token_pepper_here_CHANGE_IN_PRODUCTION

# Node environment
NODE_ENV=development

# ============================================================================
# ADMIN CONFIGURATION
# ============================================================================
# Admin credentials for admin portal access
ADMIN_USERNAME=admin
ADMIN_PASSWORD=$2b$12$your_bcrypt_hashed_password

# Optional: Access code for admin registration
ADMIN_ACCESS_CODE=your_access_code_here

# ============================================================================
# OPTIONAL SERVICES
# ============================================================================

# Sentry (Error Tracking)
# Get from: https://sentry.io/settings/projects/
VITE_SENTRY_DSN=https://your-key@sentry.io/project-id

# OpenAI (For Ximi AI Conversations) - OR use Replit AI
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_key_here
OPENAI_API_BASE=https://api.openai.com/v1

# ============================================================================
# PUSH NOTIFICATIONS (VAPID Keys for Web Push)
# ============================================================================
# Generate VAPID keys with: npx web-push generate-vapid-keys
# These keys are used for sending push notifications to users' devices
# Public key is shared with the frontend, private key stays on server

VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_EMAIL=mailto:support@roomxiconnect.org

# ============================================================================
# MOBILE CONFIGURATION (for Capacitor builds)
# ============================================================================
# API base URL for mobile app (use your deployed Replit URL)
# This is used when the app runs on iOS/Android instead of localhost
VITE_API_BASE_URL=https://your-replit-url.repl.co

# ============================================================================
# DEVELOPMENT ONLY
# ============================================================================

# Enable debug logging
VITE_DEBUG=false

# Enable mock data for testing
VITE_USE_MOCK_DATA=false

# ============================================================================
# SECURITY REQUIREMENTS FOR PRODUCTION
# ============================================================================
# CRITICAL - These environment variables are REQUIRED in production:
#
# 1. DATABASE_URL - Neon PostgreSQL connection string with SSL
#    - Server will refuse to start without this
#
# 2. SESSION_SECRET - Strong random secret (32+ characters)
#    - Server will refuse to start in production without this
#    - Used for session encryption and security
#
# 3. ENCRYPTION_SECRET - Strong random secret (32+ characters)
#    - Required for health data and journal entry encryption
#    - Server will throw error when accessing encrypted data without this
#
# 4. EMAIL_PROVIDER + Credentials - Either Gmail or SendGrid
#    - EMAIL_PROVIDER must be set to "gmail" or "sendgrid"
#    - If "gmail": GMAIL_USER and GMAIL_APP_PASSWORD required
#    - If "sendgrid": SENDGRID_API_KEY required
#
# 5. SAFETY_PLAN_TOKEN_PEPPER - Strong random secret (32+ characters)
#    - Required for hashing safety plan share link tokens
#    - Security risk if exposed
#
# 6. ADMIN_USERNAME and ADMIN_PASSWORD - Admin credentials (recommended)
#    - Used for admin portal access
#    - Password should be bcrypt hashed (32+ character hash)
#
# 7. VAPID_PUBLIC_KEY and VAPID_PRIVATE_KEY - Web push notification keys (recommended)
#    - Generated with: npx web-push generate-vapid-keys
#    - Enables push notifications for mobile and web
#
# Generate strong secrets with:
#   openssl rand -base64 32
# Or for hex format:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# ============================================================================
# NOTES
# ============================================================================
# 
# 1. NEVER commit .env file to git
# 2. Keep production keys separate from development keys
# 3. Rotate keys regularly (every 90 days recommended)
# 4. Verify email sender domain before sending production emails
# 5. Test all integrations in staging before production
# 6. Rate limiting is automatically enabled (50 auth req/15min, 200 writes/10min)
# 7. For mobile builds, ensure VITE_API_BASE_URL points to your production server
# 8. Ensure PUBLIC_URL or REPLIT_APP_URL is set for email links to work correctly
#
# For detailed setup instructions, see:
# - docs/DEPLOYMENT.md
# - SECURITY_ARCHITECTURE.md
# - MOBILE_BUILD.md

