{
  "name": "room-xi-connect",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.js",
    "dev:client": "vite --port 5000 --host 0.0.0.0",
    "build": "vite build",
    "build:mobile": "vite build",
    "preview": "vite preview --port 5000 --host 0.0.0.0",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "npx playwright test",
    "test:e2e:routes": "npx playwright test tests/e2e/routes.spec.ts",
    "smoke:privacy": "npx playwright test tests/e2e/smoke-privacy.spec.ts",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "cleanup:unconsented": "tsx scripts/cleanup-unconsented-accounts.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx server/seed.js",
    "start": "NODE_ENV=production tsx server/index.js",
    "setup:mobile": "npx cap add ios && npx cap add android && npm run build:mobile && npm run cap:sync",
    "setup:mobile:ios": "npx cap add ios && npm run build:mobile && npm run cap:sync:ios",
    "setup:mobile:android": "npx cap add android && npm run build:mobile && npm run cap:sync:android",
    "cap:sync": "cap sync",
    "cap:sync:ios": "cap sync ios",
    "cap:sync:android": "cap sync android",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "cap:run:android": "cap run android --livereload --external",
    "cap:copy": "cap copy"
  },
  "dependencies": {
    "@axe-core/react": "^4.11.0",
    "@capacitor/android": "^7.4.4",
    "@capacitor/app": "^7.1.0",
    "@capacitor/cli": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@capacitor/haptics": "^7.0.2",
    "@capacitor/ios": "^7.4.4",
    "@capacitor/preferences": "^7.0.2",
    "@capacitor/splash-screen": "^7.0.3",
    "@capacitor/status-bar": "^7.0.3",
    "@google/generative-ai": "^0.24.1",
    "@json2csv/plainjs": "^7.0.6",
    "@neondatabase/serverless": "^1.0.2",
    "@playwright/test": "^1.57.0",
    "@sendgrid/mail": "^8.1.6",
    "@supabase/supabase-js": "^2.45.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.5",
    "@types/express-session": "^1.18.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.1",
    "@types/nodemailer": "^7.0.3",
    "@types/pino-http": "^5.8.4",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@zxing/browser": "^0.1.1",
    "bad-words": "^4.0.0",
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.44.7",
    "eslint": "^9.38.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.2",
    "framer-motion": "^11.0.0",
    "globals": "^16.5.0",
    "h3-js": "^4.3.0",
    "html2canvas": "^1.4.1",
    "i18next": "^25.6.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "idb": "^7.1.1",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.356.0",
    "luxon": "^3.7.2",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.10",
    "openai": "^6.8.1",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.2",
    "prettier": "^3.6.2",
    "qr-code-styling": "^1.9.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.50.0",
    "react-i18next": "^16.2.4",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.23.0",
    "recharts": "^2.12.0",
    "simple-statistics": "^7.8.8",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "web-push": "^3.6.7",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.8",
    "@types/react": "^18.2.70",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/ui": "^1.6.0",
    "autoprefixer": "^10.4.19",
    "drizzle-kit": "^0.31.6",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.50.1",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^1.6.0"
  }
}
